# Asset Store tools and downloaded packages
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Autogenerated crash reports
sysinfo.txt
crashlytics-build.properties

# ---------------------------------------------------------
# Visual Studio / Rider / VS Code
# ---------------------------------------------------------
.vs/
.idea/
.vscode/
.consulo/
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# Solution and project files are regenerated by Unity
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------
# Build outputs / binaries
# ---------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
*.exe
*.dll.mdb
*.dll.meta.mdb

# Gradle / Android export
.gradle/
*.iml

# ---------------------------------------------------------
# OS junk
# ---------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------
# Unity3D generated meta files for ignored folders
# ---------------------------------------------------------
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------
# Photon Fusion / PUN
# ---------------------------------------------------------
# Fusion's generated network code (regenerated on compile)
/[Aa]ssets/[Ff]usion/[Rr]untime/[Ff]usion.[Cc]odeGen*
Fusion.CodeGen.dll*

# Local secrets — uncomment if you move the AppId out of PhotonServerSettings
# Assets/Photon/PhotonUnityNetworking/Resources/PhotonServerSettings.asset
# Assets/Photon/Fusion/Resources/PhotonAppSettings.asset
